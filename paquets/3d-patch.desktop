[Desktop Entry]
Type=Application
Name=3D-Patch
GenericName=3D modeler
GenericName[fr]=Modeleur 3D
GenericName[es]=Modelador 3D
GenericName[it]=Modellatore 3D
GenericName[de]=3D-Modellierer
Comment=3D modeler for 3D printing: repair, edit, textures, prepare
