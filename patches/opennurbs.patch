diff --git a/opennurbs_mingw_compat.h b/opennurbs_mingw_compat.h
new file mode 100644
index 0000000..22a8745
--- /dev/null
+++ b/opennurbs_mingw_compat.h
@@ -0,0 +1,32 @@
+/* 3D-Patch : compatibilité openNURBS <-> mingw-w64 (Windows, GCC). Inclus par -include.
+   openNURBS suppose MSVC sous Windows ; on fournit les quelques fonctions manquantes.
+   Les variantes « _l » ignorent la locale : l'appli tourne en locale « C ». */
+#pragma once
+#if defined(__MINGW32__) && defined(__cplusplus)
+#include <stdio.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <time.h>
+#include <wchar.h>
+#include <locale.h>
+#include <dirent.h>
+#include <limits.h>
+#include <string.h>
+#define fcloseall _fcloseall
+#ifndef NAME_MAX
+#define NAME_MAX 260
+#endif
+static inline int vsnprintf_l(char* b, size_t n, _locale_t, const char* f, va_list a) { return vsnprintf(b, n, f, a); }
+static inline int snprintf_l(char* b, size_t n, _locale_t, const char* f, ...) { va_list a; va_start(a, f); int r = vsnprintf(b, n, f, a); va_end(a); return r; }
+static inline int sprintf_l(char* b, _locale_t, const char* f, ...) { va_list a; va_start(a, f); int r = vsprintf(b, f, a); va_end(a); return r; }
+static inline int sscanf_l(const char* s, _locale_t, const char* f, ...) { va_list a; va_start(a, f); int r = vsscanf(s, f, a); va_end(a); return r; }
+static inline int vsscanf_l(const char* s, _locale_t, const char* f, va_list a) { return vsscanf(s, f, a); }
+static inline int _vsscanf_s_l(const char* s, const char* f, _locale_t, va_list a) { return vsscanf(s, f, a); }
+static inline int _vswscanf_s_l(const wchar_t* s, const wchar_t* f, _locale_t, va_list a) { return vswscanf(s, f, a); }
+static inline struct tm* localtime_r(const time_t* t, struct tm* r) { return localtime_s(r, t) == 0 ? r : nullptr; }
+static inline int readdir_r(DIR* d, struct dirent* e, struct dirent** res) {
+  struct dirent* x = readdir(d);
+  if (!x) { *res = nullptr; return 0; }
+  memcpy(e, x, sizeof(*e)); *res = e; return 0;
+}
+#endif
